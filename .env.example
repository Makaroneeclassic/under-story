# =========================================================
# UNDERSTORY VENUE - ENVIRONMENT VARIABLES CONFIGURATION
# =========================================================
# Instructions for Vercel & Supabase:
#
# 1. Supabase Project URL:
#    Find in Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Key (Public API Key):
#    Find in Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Supabase Service Role Key (Optional, for secure backend operations):
#    Find in Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. LINE Official Account / Messaging API (Optional fallback if not set in Admin UI):
#    Find in LINE Developers Console -> Messaging API -> Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token-here

# 5. LINE Notification Target ID (User ID or Group ID):
#    User ID (starts with U...) from Basic Settings or Group ID (starts with C...)
LINE_TARGET_ID=your-line-user-id-or-group-id-here
